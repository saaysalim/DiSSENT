DISSENT_API_KEY=replace-with-a-long-random-value

# Email (SMTP). Leave these empty to use the local Mailpit inbox (http://127.0.0.1:8025).
# For real email, fill them in, e.g. SMTP_PORT=587 with SMTP_SECURE=tls, or 465 with ssl.
# SMTP_FROM can be an address or "Name <address>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
