DISSENT_API_KEY=replace-with-a-long-random-value

# AES-256 key shared by securecomm and securecomm2 (32 random bytes, base64).
# Both refuse to start without it. start-demo.ps1 creates it if it is missing. To make one yourself:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# (or: openssl rand -base64 32). Never reuse the old default from application.properties.
API_CRYPTO_AES_KEY_BASE64=

# Optional. 1 shows password-reset links on screen, only to a browser on this computer. Default 0.
APP_DEBUG=0

# Email (SMTP). Leave these empty to use the local Mailpit inbox (http://127.0.0.1:8025).
# For real email, fill them in, e.g. SMTP_PORT=587 with SMTP_SECURE=tls, or 465 with ssl.
# SMTP_FROM can be an address or "Name <address>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=

# Who gets an email when someone uses the Contact form.
# Empty: admin@dissent.local while using Mailpit; no email with real SMTP.
ADMIN_EMAIL=

# AI compliance check (see ai/README.md).
# AI_ENABLED: 0 = the current rule-based check (default); 1 = ask the AI service.
# If the service is down, slower than AI_TIMEOUT_SECONDS or answers wrongly, the message is held.
AI_ENABLED=0
AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_SECONDS=5
# Which model the AI service uses: mock (default, rule-based, nothing leaves the server),
# ollama (local model, stub, needs OLLAMA_URL and OLLAMA_MODEL) or cloud (stub).
AI_MODEL=mock
OLLAMA_URL=
OLLAMA_MODEL=
# A cloud model sends message text off the server. Keep 0 unless the supervisor approves;
# then also set AI_CLOUD_MODEL and put the key in AI_API_KEY (never in code).
AI_ALLOW_CLOUD=0
AI_CLOUD_MODEL=
AI_API_KEY=
